# Dockerfile for Fly.io - Optimized
# This is a combined backend + frontend + nginx Dockerfile
# Fly.io will build and run this

# Stage 1: Build Frontend
FROM node:18-alpine AS frontend-builder

WORKDIR /app-frontend

COPY frontend-web/package*.json ./

RUN npm cache clean --force && npm install --legacy-peer-deps

COPY frontend-web/src ./src
COPY frontend-web/tsconfig.json ./
COPY frontend-web/vite.config.ts ./
COPY frontend-web/index.html ./

RUN npm run build

# Stage 2: Build Backend
FROM node:18-alpine AS backend-builder

WORKDIR /app-backend

COPY backend/package*.json ./

RUN npm cache clean --force && npm install --legacy-peer-deps

COPY backend/src ./src
COPY backend/tsconfig.json ./

RUN npm run build

# Stage 3: Production Runtime
FROM node:18-alpine

WORKDIR /app

# Install dumb-init to handle signals properly
RUN apk add --no-cache dumb-init

# Copy package files
COPY backend/package*.json ./

# Install only production dependencies
RUN npm cache clean --force && npm install --production --legacy-peer-deps

# Copy built backend from builder
COPY --from=backend-builder /app-backend/dist ./dist

# Copy built frontend for serving static files
COPY --from=frontend-builder /app-frontend/dist ./public

# Create data directory for mounts
RUN mkdir -p /app/data

# Expose port 8080 (Fly.io default)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Use dumb-init to handle signals
ENTRYPOINT ["dumb-init", "--"]

# Start server
CMD ["npm", "start"]
