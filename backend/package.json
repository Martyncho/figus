{
    "name": "panini-backend",
    "version": "1.0.0",
    "description": "Panini Figuritas - Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "migrate": "ts-node src/migrations/run.ts",
        "docker:build": "docker build -t panini-api:latest .",
        "docker:run": "docker run -p 3000:3000 --env-file .env panini-api:latest"
    },
    "keywords": [
        "panini",
        "figuritas",
        "api",
        "express",
        "typescript"
    ],
    "author": "Panini Team",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "express-rate-limit": "^6.7.0",
        "cors": "^2.8.5",
        "helmet": "^7.0.0",
        "dotenv": "^16.0.3",
        "pg": "^8.10.0",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.0",
        "bcryptjs": "^2.4.3",
        "axios": "^1.4.0",
        "aws-sdk": "^2.1400.0",
        "multer": "^1.4.5-lts.1",
        "joi": "^17.9.2",
        "pino": "^8.14.1",
        "pino-pretty": "^10.2.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.17",
        "@types/node": "^20.2.5",
        "@types/jwt-decode": "^3.1.0",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/cors": "^2.8.13",
        "@types/pg": "^8.10.3",
        "@types/multer": "^1.4.7",
        "@types/bcryptjs": "^2.4.2",
        "typescript": "^5.1.3",
        "tsx": "^4.7.0",
        "ts-node": "^10.9.1",
        "nodemon": "^2.0.22",
        "jest": "^29.5.0",
        "@types/jest": "^29.5.2",
        "ts-jest": "^29.1.0",
        "eslint": "^8.43.0",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "prettier": "^2.8.8"
    }
}