# Backend Environment Variables - Production (Railway + Supabase)

# Node Environment
NODE_ENV=production
PORT=3000
API_URL=https://tuapi-production.up.railway.app

# Database (Supabase PostgreSQL)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres

# Redis (Redis Cloud - Free tier)
# Formato: redis://[username]:[password]@[host]:[port]
REDIS_URL=redis://default:[password]@redis.cloud-endpoint.com:12345

# JWT
JWT_SECRET=generate-a-long-random-string-here-min-32-chars
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=generate-another-long-random-string-here-min-32-chars
REFRESH_TOKEN_EXPIRY=30d

# CORS
CORS_ORIGIN=https://panini.vercel.app

# OAuth - Facebook (optional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://tuapi-production.up.railway.app/api/auth/facebook/callback
