# Fly.io Environment Variables
# Use: flyctl secrets set < .env.flyio
# Or: flyctl secrets set VAR=VALUE

# Database (set after creating PostgreSQL)
DATABASE_URL=postgresql://pani_user:password@pani-db.internal:5432/pani_db

# Redis (Upstash or Fly.io)
REDIS_URL=redis://:password@redis-server.upstash.io:12345

# App Configuration
NODE_ENV=production
PORT=8080

# Authentication
JWT_SECRET=your_very_long_and_random_jwt_secret_here_change_in_production

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=pani-stickers

# CORS
CORS_ORIGIN=https://pani.fly.dev,https://your-domain.com

# Optional: OAuth Providers
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
