# Mobile App Environment Variables

# API Configuration
VITE_API_URL=http://192.168.1.100:3000/api
VITE_API_TIMEOUT=15000

# OAuth Configuration
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_INSTAGRAM_APP_ID=your_instagram_app_id
VITE_TIKTOK_APP_ID=your_tiktok_app_id

# OAuth Callback URLs (para app nativa)
VITE_FACEBOOK_CALLBACK_URL=panini://auth/facebook
VITE_INSTAGRAM_CALLBACK_URL=panini://auth/instagram
VITE_TIKTOK_CALLBACK_URL=panini://auth/tiktok

# App Configuration
VITE_APP_NAME=Panini Figuritas
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Platform Configuration
VITE_PLATFORM=mobile
VITE_IS_NATIVE_BRIDGE_AVAILABLE=true

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_CAMERA=true
VITE_ENABLE_OCR=true

# Cloud Services
VITE_GOOGLE_VISION_API_KEY=your_google_vision_api_key
VITE_SENTRY_DSN=your_sentry_dsn_url
