# Production Environment Variables
# Copy this file to .env and fill in with actual values before running docker-compose

# Database Configuration
DB_NAME=pani_db
DB_USER=pani_user
DB_PASSWORD=CHANGE_ME_VERY_SECURE_PASSWORD

# Redis Configuration  
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_ME_JWT_SECRET_VERY_LONG_AND_RANDOM

# AWS Configuration (for S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=pani-stickers

# API Configuration
NODE_ENV=production
CORS_ORIGIN=https://tudominio.com,https://api.tudominio.com

# OAuth Providers (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
