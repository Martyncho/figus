{
    "name": "panini-frontend",
    "version": "1.0.0",
    "description": "Panini Figuritas - Frontend Web",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
        "test": "vitest",
        "test:ui": "vitest --ui"
    },
    "keywords": [
        "panini",
        "figuritas",
        "react",
        "vite"
    ],
    "author": "Panini Team",
    "license": "MIT",
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.11.2",
        "@reduxjs/toolkit": "^1.9.5",
        "react-redux": "^8.1.1",
        "axios": "^1.4.0",
        "@tanstack/react-query": "^4.29.12",
        "zustand": "^4.3.8"
    },
    "devDependencies": {
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "@vitejs/plugin-react": "^4.0.0",
        "eslint": "^8.43.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "prettier": "^2.8.8",
        "typescript": "^5.1.3",
        "vite": "^4.3.9",
        "vitest": "^0.33.0"
    }
}