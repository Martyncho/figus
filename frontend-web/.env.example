# Frontend Environment Variables - Development

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# OAuth Configuration
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_INSTAGRAM_APP_ID=your_instagram_app_id
VITE_TIKTOK_APP_ID=your_tiktok_app_id

# App Configuration
VITE_APP_NAME=Panini Figuritas
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=true

# Cloud Services
VITE_GOOGLE_ANALYTICS_ID=your_google_analytics_id
VITE_SENTRY_DSN=your_sentry_dsn_url
